# Backend LLM config (Firebase Functions Gen2) — COMMITTED TEMPLATE.
# Copy to `backend/.env` and fill the secret locally:  cp backend/.env.example backend/.env
#
# SECURITY (INV-3): the LLM key is BACKEND-ONLY. Never bundle it in the Flutter app.
#   - Local dev: put the real key in `backend/.env` (git-ignored).
#   - Production: use Firebase Secret Manager, NOT .env:
#       firebase functions:secrets:set LLM_API_KEY
#     and read it in code via defineSecret('LLM_API_KEY') (ADR-0008).
# Never commit real keys. `.env` is git-ignored; this `.env.example` is safe to commit.

# Active provider (provider-agnostic adapter, ADR-0006): minimax | gemini | openai | gpt | hive
LLM_PROVIDER=minimax

# Active provider's API key — put the real value in backend/.env.local, NOT here and
# NOT in backend/.env: `firebase deploy` turns .env into the function's plain env
# vars, which would collide with the LLM_API_KEY Secret Manager binding.
# Deploys read it from Secret Manager (`firebase functions:secrets:set LLM_API_KEY`).
LLM_API_KEY=

# OpenAI-compatible endpoint (MiniMax global host; Mainland China: https://api.minimaxi.com/v1)
LLM_BASE_URL=https://api.minimax.io/v1

# Model id — VERIFY the current MiniMax model id before use (docs may change)
LLM_MODEL=MiniMax-M2.1

# Reasoning is quality-gated before rollout. `adaptive` preserves the provider
# default. Set `disabled` only after the paired live evaluation passes.
LLM_REASONING_MODE=adaptive
# Optional positive integer. Keep it unset for adaptive reasoning: the 2026-09-23
# smoke test showed 8,192 can be spent on thought before JSON is complete. Only
# set a cap after that exact reasoning mode passes the paired live evaluation.
# LLM_MAX_COMPLETION_TOKENS=8192

# Worker self-deadline basis (seconds). Keep equal to the deployed timeoutSeconds
# (ADR-0016: 540). The worker aborts at WORKER_TIMEOUT_SEC-15 so it can still
# record the job as `error` and send the failure push.
WORKER_TIMEOUT_SEC=540

# ── 토스 로그인 (앱인토스 콘솔 발급) ───────────────────────────────────────────
# 파트너 API 는 mTLS 를 요구한다. PKCS#12 를 base64 로 넣거나(권장, 콘솔이 .p12 로
# 준다) PEM 두 개로 넣는다. 둘 다 Node 22 에서 실측 확인됨.
# 프로덕션은 Secret Manager 에 올린다 — .env 는 함수 env 로 그대로 배포된다.
#   firebase functions:secrets:set TOSS_CLIENT_PFX_BASE64
#   firebase functions:secrets:set TOSS_CLIENT_PFX_PASSPHRASE
#   firebase functions:secrets:set SESSION_SECRET
TOSS_CLIENT_PFX_BASE64=
TOSS_CLIENT_PFX_PASSPHRASE=
# 또는 PEM:
# TOSS_CLIENT_CERT=
# TOSS_CLIENT_KEY=

# 세션 토큰 서명키. 아무 고엔트로피 문자열이면 된다: openssl rand -base64 32
# 없으면 /v1/auth/toss 가 503 을 내고 토스 로그인이 비활성된다.
SESSION_SECRET=

# 토스 콘솔에서 발급된 REWARDED 광고 그룹 ID. 공개 식별값이며 서버가 앱에 전달한다.
# INTERSTITIAL/테스트용 그룹을 운영 보상으로 사용하지 않는다. 미설정 시 보상형 정책은 비활성이다.
TOSS_REWARDED_AD_GROUP_ID=
# 새 광고 화면이 포함된 미니앱의 정식 출시와 광고 그룹 준비를 확인한 후에만 true.
# 전환 중 false(기본값)는 토스의 기존 주 3회 한도도, 광고 요구도 적용하지 않는다.
TOSS_REWARDED_GENERATION_ENABLED=false
